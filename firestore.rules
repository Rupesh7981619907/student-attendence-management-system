rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection probe endpoint for system startup verification
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      // Class Sessions subcollection
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId)
                      && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(sessionId)
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      // Students roster subcollection
      match /students/{studentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(studentId)
                      && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(studentId)
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(studentId);
      }

      // Attendance history subcollection
      match /attendance_records/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId)
                      && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(recordId)
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(recordId);
      }
    }
  }
}
